// Icon und Versionsinfo der EXE. Wird von CMake aus static/version.txt befuellt.
#include <windows.h>

IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/static/brand/Icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @KERS_VERSION_RC@,0
 PRODUCTVERSION @KERS_VERSION_RC@,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "CompanyName",      "KERS"
            VALUE "FileDescription",  "KERS Subsystems - F1 26 Telemetrie-Overlay"
            VALUE "FileVersion",      "@KERS_VERSION@"
            VALUE "InternalName",     "KERS_Subsystems"
            VALUE "LegalCopyright",   "MIT License, (c) 2026 WHO_KERS"
            VALUE "OriginalFilename", "KERS_Subsystems.exe"
            VALUE "ProductName",      "KERS Subsystems"
            VALUE "ProductVersion",   "@KERS_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
