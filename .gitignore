# Virtuelle Umgebung - wird per requirements.txt neu erzeugt (run.bat)
venv/
.venv/

# Python-Bytecode
__pycache__/
*.py[cod]

# Laufzeit-Zustand, kein Quelltext:
# Fensterposition, Bildschirmgroesse und Renderer-Wahl des HUD.
hud/hud_state.json

# Diagnose-Mitschrift zur Vordergrund-Lage (qml_overlay._diagnose_lage)
hud_topmost.log
hud/hud_topmost.log
# Absturz-Mitschrift des HUD. Entstand beim Testen und waere um ein Haar
# mitgewandert - sie enthaelt lokale Pfade und gehoert nicht ins Repo.
hud_error.log
hud/hud_error.log

# Persoenliche Einstellungen - seit 0.1.1 bewusst weder in der EXE noch im Repo:
# Branding, Logo, Skalierung. main.py legt fehlende beim ersten Lauf selbst an.
overlay_settings.json
presets.json
# Gespeicherte Layouts (Stufe 4). Gleiche Begruendung wie presets.json daneben:
# Laufzeit-Zustand des Benutzers, kein Quelltext.
layouts.json
# Selbst gelernte Streckenkonturen neben der .exe. ⚠ NICHT static/tracks.json -
# die ist die mitgelieferte und gehoert ins Repo.
/tracks.json

# Aufzeichnungen und Mitschnitte (koennen sehr gross werden)
sessions/
recordings/
*.f1rec

# Sicherungen
Backups/
*.bak

# Build-Ergebnisse (die EXE haengt am Release, nicht im Repo)
build/
dist/
output/
*.exe
*.spec

# Windows / Editoren
Thumbs.db
desktop.ini
.vscode/
.idea/
